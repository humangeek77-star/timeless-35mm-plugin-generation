{
  "manifestVersion": 5,
  "id": "com.timeless.reconstruction",
  "name": "Timeless 35mm Reconstruction",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "data": {
        "apiVersion": 2
      },
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "timelessPanel",
      "label": {
        "default": "Timeless 35mm Reconstruction"
      },
      "minimumSize": {
        "width": 320,
        "height": 450
      },
      "maximumSize": {
        "width": 800,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 680
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": [
        "file",
        "http",
        "https"
      ],
      "extensions": [
        ".py",
        ".bat",
        ".cmd",
        ".exe",
        ".sh"
      ]
    },
    "network": {
      "domains": "all"
    },
    "node": true,
    "ipc": {
      "enablePluginCommunication": true
    },
    "allowCodeGenerationFromStrings": true
  }
}
